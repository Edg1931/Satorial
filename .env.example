ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Production (recommended): hosted libsql via Turso. Persists on Vercel.
# Get a URL + token from https://turso.tech (free tier).
# TURSO_DATABASE_URL=libsql://yourdb.turso.io
# TURSO_AUTH_TOKEN=

# Local dev: defaults to file:./data/satorial.db.
# Vercel without Turso: app auto-detects and uses /tmp/satorial.db (ephemeral).
# Self-hosted with persistent volume: e.g. file:/data/satorial.db
# SATORIAL_DB_PATH=file:./data/satorial.db
